{
  "openapi": "3.0.3",
  "info": {
    "title": "Pulso Urbano — API Pública",
    "version": "1.0.0",
    "description": "Especificação pública da plataforma Pulso Urbano (Squad Elementares — FATEC SJC). Contém exclusivamente as operações abertas a munícipes, cidadãos e consultas públicas (login, autocadastro, séries históricas, últimas leituras, IQAr, status das estações por município e exportação de medições em JSON/CSV). Operações administrativas e de gestão são restritas e documentadas no manual interno da Tecsus.\n\n### Automação diária de download CSV (exemplo com cron às 08:00)\nO repositório inclui scripts prontos em `scripts/exemplo-download-csv.sh` (Bash) e `scripts/exemplo-download-csv.js` (Node.js) que fazem login em `POST /auth/login`, obtêm o token Bearer JWT e baixam o CSV do dia anterior em `GET /relatorios/medicoes?formato=csv&inicio=AAAA-MM-DD&fim=AAAA-MM-DD`:\n\n```cron\n0 8 * * * API_URL=http://localhost EMAIL=ana.silva@exemplo.com SENHA=... /caminho/para/scripts/exemplo-download-csv.sh >> /var/log/pulso_csv.log 2>&1\n```"
  },
  "servers": [
    {
      "url": "http://localhost",
      "description": "API Gateway Nginx local"
    }
  ],
  "tags": [
    {
      "name": "Autenticação",
      "description": "Autenticação de usuários e emissão de tokens JWT"
    },
    {
      "name": "Munícipes",
      "description": "Autocadastro com aceite de aviso de privacidade"
    },
    {
      "name": "Dados Ambientais",
      "description": "Séries históricas, últimas leituras e IQAr (acesso público por município ou autenticado com limites de período e cotas)"
    },
    {
      "name": "Relatórios e CSV",
      "description": "Exportação de medições em JSON e CSV para munícipes, pesquisadores e demais perfis autenticados"
    },
    {
      "name": "Estações",
      "description": "Consulta pública de municípios atendidos e status operacional das estações"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Autenticação"],
        "operationId": "loginUsuario",
        "summary": "Realizar login e obter token JWT",
        "description": "Autentica um usuário cadastrado (munícipe, pesquisador, gestor ou administrador) e emite um token Bearer JWT (HS256) com validade de 8 horas.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "examples": {
                "loginMunicipe": {
                  "summary": "Login de Munícipe",
                  "value": {
                    "email": "ana.silva@exemplo.com",
                    "senha": "SenhaForte@2026"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "examples": {
                  "tokenValido": {
                    "summary": "Credenciais válidas",
                    "value": {
                      "token": "<jwt-token>",
                      "usuario": {
                        "id": "11111111-2222-3333-4444-555555555555",
                        "nome": "Ana da Silva",
                        "papel": "MUNICIPE",
                        "municipio": "São José dos Campos"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Credenciais inválidas."
                }
              }
            }
          },
          "403": {
            "description": "Conta inativa.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Acesso revogado. Conta inativa."
                }
              }
            }
          }
        }
      }
    },
    "/usuarios/cadastro": {
      "post": {
        "tags": ["Munícipes"],
        "operationId": "cadastrarMunicipe",
        "summary": "Autocadastro de munícipe",
        "description": "Permite que qualquer cidadão crie uma conta pública própria vinculada ao papel canônico MUNICIPE. Exige aceite expresso do aviso de privacidade. Protegido por rate limiter de até 5 cadastros por hora por IP.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CadastroMunicipeRequest"
              },
              "examples": {
                "cadastroValido": {
                  "summary": "Cadastro válido de munícipe",
                  "value": {
                    "nome": "Ana da Silva",
                    "email": "ana.silva@exemplo.com",
                    "senha": "SenhaForte@2026",
                    "municipio": "São José dos Campos",
                    "aceite_privacidade": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Munícipe cadastrado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioPublicoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos (senha fora do padrão, e-mail inválido ou ausência do aceite de privacidade).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "E-mail já cadastrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Limite de taxa excedido (máximo 5 cadastros por hora por IP).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/analise/publico/{municipio}/estacoes/{codigo}/series": {
      "get": {
        "tags": ["Dados Ambientais"],
        "operationId": "obterSeriesPublicas",
        "summary": "Obter séries históricas da estação (Público)",
        "description": "Versão pública da consulta de séries históricas sem exigência de autenticação, filtrada por município e restrita a estações ativas (limite máximo de até 7 dias para acesso anônimo; acima disso retorna 400).",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/MunicipioParam"
          },
          {
            "$ref": "#/components/parameters/EstacaoCodigoParam"
          },
          {
            "name": "grandeza",
            "in": "query",
            "required": true,
            "description": "Grandeza que será consultada (ex.: PM25, PM10, Temperatura).",
            "schema": {
              "type": "string",
              "example": "PM25"
            }
          },
          {
            "name": "periodo",
            "in": "query",
            "required": true,
            "description": "Período da série histórica (para acesso anônimo, o limite máximo é 7d).",
            "schema": {
              "type": "string",
              "enum": ["24h", "7d", "30d"],
              "example": "24h"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Séries históricas recuperadas com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeriesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros inválidos ou período superior ao limite permitido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Estação não encontrada ou indisponível no município informado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/analise/publico/{municipio}/estacoes/{codigo}/ultimas-leituras": {
      "get": {
        "tags": ["Dados Ambientais"],
        "operationId": "obterUltimasLeiturasPublicas",
        "summary": "Obter últimas leituras da estação (Público)",
        "description": "Retorna as últimas leituras calibradas de uma estação ativa pertencente ao município informado, sem necessidade de autenticação.",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/MunicipioParam"
          },
          {
            "$ref": "#/components/parameters/EstacaoCodigoParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Últimas leituras recuperadas com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UltimasLeiturasResponse"
                }
              }
            }
          },
          "404": {
            "description": "Estação não encontrada ou indisponível no município informado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/analise/publico/{municipio}/iqar": {
      "get": {
        "tags": ["Dados Ambientais"],
        "operationId": "obterIqarPublico",
        "summary": "Obter IQAr por município (Público)",
        "description": "Retorna o Índice de Qualidade do Ar (IQAr) filtrado por município e estações ativas, sem necessidade de autenticação.",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/MunicipioParam"
          },
          {
            "name": "estacaoId",
            "in": "query",
            "required": false,
            "description": "Identificador ou código opcional de uma estação ativa pertencente ao município informado.",
            "schema": {
              "type": "string",
              "example": "EST-001"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "IQAr recuperado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IqarResponse"
                }
              }
            }
          },
          "404": {
            "description": "Estação não encontrada ou indisponível no município informado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/analise/estacoes/{id}/series": {
      "get": {
        "tags": ["Dados Ambientais"],
        "operationId": "obterSeriesHistoricas",
        "summary": "Obter séries históricas da estação",
        "description": "Retorna as séries históricas agrupadas (5 min para 24h, 1h para 7d, 1 dia para 30d). Sem login permite até 7 dias; MUNICIPE autenticado permite até 30 dias com cota de 2.000 requisições/semana e 6.000 requisições/mês; PESQUISADOR até 365 dias; GESTOR_PUBLICO e ADMINISTRADOR são ilimitados.",
        "security": [
          {
            "BearerAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/EstacaoIdParam"
          },
          {
            "name": "grandeza",
            "in": "query",
            "required": true,
            "description": "Grandeza desejada (ex.: PM25, PM10, O3).",
            "schema": {
              "type": "string",
              "example": "PM25"
            }
          },
          {
            "name": "periodo",
            "in": "query",
            "required": true,
            "description": "Período desejado.",
            "schema": {
              "type": "string",
              "enum": ["24h", "7d", "30d"],
              "example": "24h"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Série histórica recuperada com sucesso.",
            "headers": {
              "X-Cota-Semana-Restante": {
                "description": "Saldo restante da cota semanal do usuário (quando autenticado).",
                "schema": {
                  "type": "integer",
                  "example": 1999
                }
              },
              "X-Cota-Mes-Restante": {
                "description": "Saldo restante da cota mensal do usuário (quando autenticado).",
                "schema": {
                  "type": "integer",
                  "example": 5999
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeriesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros inválidos ou período solicitado excede o limite permitido para o perfil atual.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Estação não encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Cota semanal ou mensal de requisições excedida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaExceededResponse"
                }
              }
            }
          }
        }
      }
    },
    "/analise/estacoes/{id}/ultimas-leituras": {
      "get": {
        "tags": ["Dados Ambientais"],
        "operationId": "obterUltimasLeituras",
        "summary": "Obter últimas leituras dos sensores da estação (Autenticado)",
        "description": "Retorna o último valor calibrado de cada sensor ativo da estação indicada. Requer token Bearer JWT; debita da cota do perfil.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/EstacaoIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Últimas leituras recuperadas com sucesso.",
            "headers": {
              "X-Cota-Semana-Restante": {
                "description": "Saldo restante da cota semanal.",
                "schema": {
                  "type": "integer",
                  "example": 1999
                }
              },
              "X-Cota-Mes-Restante": {
                "description": "Saldo restante da cota mensal.",
                "schema": {
                  "type": "integer",
                  "example": 5999
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UltimasLeiturasResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Estação não encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Cota semanal ou mensal excedida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaExceededResponse"
                }
              }
            }
          }
        }
      }
    },
    "/analise/estacoes/{id}/iqar": {
      "get": {
        "tags": ["Dados Ambientais"],
        "operationId": "obterIqarEstacao",
        "summary": "Obter Índice de Qualidade do Ar (IQAr) da estação (Autenticado)",
        "description": "Calcula o IQAr da estação com base na média móvel das últimas 24 horas de leituras válidas de PM2.5, segundo as faixas oficiais brasileiras (CONAMA nº 506/2024 / CETESB). Requer token Bearer JWT.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/EstacaoIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "IQAr recuperado com sucesso.",
            "headers": {
              "X-Cota-Semana-Restante": {
                "description": "Saldo restante da cota semanal.",
                "schema": {
                  "type": "integer",
                  "example": 1999
                }
              },
              "X-Cota-Mes-Restante": {
                "description": "Saldo restante da cota mensal.",
                "schema": {
                  "type": "integer",
                  "example": 5999
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IqarResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Estação não encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Cota semanal ou mensal excedida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaExceededResponse"
                }
              }
            }
          }
        }
      }
    },
    "/relatorios/medicoes": {
      "get": {
        "tags": ["Relatórios e CSV"],
        "operationId": "exportarMedicoes",
        "summary": "Listar medições em JSON ou baixar em CSV",
        "description": "Devolve as medições do município no período, com filtros opcionais de estação e grandeza. `formato=json` (padrão) retorna página com total; `formato=csv` retorna o período inteiro em arquivo CSV (UTF-8 com BOM, separador `;`, vírgula decimal, horário de Brasília). MUNICIPE, PESQUISADOR e ADMINISTRADOR podem informar `municipio` na query (ou usar o município do token). Suporta automação via scripts diários (`scripts/exemplo-download-csv.sh` e `scripts/exemplo-download-csv.js`).",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "inicio",
            "in": "query",
            "required": false,
            "description": "Primeiro dia do período (AAAA-MM-DD, horário de Brasília). Padrão: ontem.",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-11-06"
            }
          },
          {
            "name": "fim",
            "in": "query",
            "required": false,
            "description": "Último dia do período, incluído inteiro (AAAA-MM-DD, horário de Brasília). Padrão: hoje. Máximo de 31 dias.",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-11-06"
            }
          },
          {
            "name": "estacao",
            "in": "query",
            "required": false,
            "description": "Códigos das estações separados por vírgula. Sem ele, todas as estações do município.",
            "schema": {
              "type": "string",
              "example": "EST-001,EST-002"
            }
          },
          {
            "name": "grandeza",
            "in": "query",
            "required": false,
            "description": "Grandezas medidas separadas por vírgula. Sem ele, todas.",
            "schema": {
              "type": "string",
              "example": "Temperatura,Umidade Relativa"
            }
          },
          {
            "name": "municipio",
            "in": "query",
            "required": false,
            "description": "Município cadastrado da estação. Se omitido, usa o município do token.",
            "schema": {
              "type": "string",
              "example": "São José dos Campos"
            }
          },
          {
            "name": "formato",
            "in": "query",
            "required": false,
            "description": "`json` (padrão) ou `csv`.",
            "schema": {
              "type": "string",
              "enum": ["json", "csv"],
              "default": "json",
              "example": "csv"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "description": "Página do JSON (a partir de 1). Ignorada quando `formato=csv`.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "porPagina",
            "in": "query",
            "required": false,
            "description": "Medições por página no JSON. Ignorado quando `formato=csv`.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000,
              "default": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Medições do período em JSON ou arquivo CSV.",
            "headers": {
              "Cache-Control": {
                "description": "Sempre `no-store`.",
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              },
              "Content-Disposition": {
                "description": "Presente quando `formato=csv`, informando o nome sugerido do arquivo.",
                "schema": {
                  "type": "string",
                  "example": "attachment; filename=\"pulso-urbano_medicoes_sao-jose-dos-campos_2026-11-06_2026-11-06.csv\""
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaMedicoes"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string",
                  "description": "UTF-8 com BOM, separador `;`, fim de linha CRLF e vírgula decimal."
                },
                "example": "lido_em;estacao_codigo;estacao_nome;municipio;sensor_codigo;grandeza;unidade;valor;valor_bruto;valida\r\n06/11/2026 11:05;EST-001;Centro;São José dos Campos;T-01;Temperatura;°C;23,4;24,9;Sim\r\n"
              }
            }
          },
          "400": {
            "description": "Filtro inválido ou município não informado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroRelatorioResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroRelatorioResponse"
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem acesso às medições.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroRelatorioResponse"
                }
              }
            }
          },
          "404": {
            "description": "Município não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroRelatorioResponse"
                }
              }
            }
          }
        }
      }
    },
    "/estacoes/publico/municipios": {
      "get": {
        "tags": ["Estações"],
        "operationId": "listarMunicipiosAtendidos",
        "summary": "Listar municípios com estações monitoradas",
        "description": "Retorna a lista de municípios distintos que possuem estações meteorológicas cadastradas, sem necessidade de autenticação (não debita cota).",
        "security": [],
        "responses": {
          "200": {
            "description": "Lista de municípios retornada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MunicipiosPublicoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/estacoes/publico/{municipio}/status": {
      "get": {
        "tags": ["Estações"],
        "operationId": "obterStatusEstacoesMunicipio",
        "summary": "Obter status público das estações do município",
        "description": "Retorna o resumo quantitativo (total, ativas, com falha e inativas) e a lista de estações do município informado sem necessidade de autenticação (não debita cota).",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/MunicipioParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Resumo de status público retornado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusEstacoesMunicipioResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT de autenticação emitido no endpoint /auth/login"
      }
    },
    "parameters": {
      "EstacaoIdParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Identificador ou código da estação meteorológica.",
        "schema": {
          "type": "string",
          "example": "estacao-01"
        }
      },
      "EstacaoCodigoParam": {
        "name": "codigo",
        "in": "path",
        "required": true,
        "description": "Código ou identificador de uma estação ativa pertencente ao município.",
        "schema": {
          "type": "string",
          "example": "EST-001"
        }
      },
      "MunicipioParam": {
        "name": "municipio",
        "in": "path",
        "required": true,
        "description": "Nome do município (ex.: 'São José dos Campos').",
        "schema": {
          "type": "string",
          "example": "São José dos Campos"
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["email", "senha"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana.silva@exemplo.com"
          },
          "senha": {
            "type": "string",
            "format": "password",
            "example": "SenhaForte@2026"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["token", "usuario"],
        "properties": {
          "token": {
            "type": "string",
            "example": "<jwt-token>"
          },
          "usuario": {
            "type": "object",
            "required": ["id", "nome", "papel"],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "nome": {
                "type": "string",
                "example": "Ana da Silva"
              },
              "papel": {
                "type": "string",
                "example": "MUNICIPE"
              },
              "municipio": {
                "type": "string",
                "nullable": true,
                "example": "São José dos Campos"
              }
            }
          }
        }
      },
      "CadastroMunicipeRequest": {
        "type": "object",
        "required": ["nome", "email", "senha", "aceite_privacidade"],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "example": "Ana da Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 150,
            "example": "ana.silva@exemplo.com"
          },
          "senha": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 72,
            "example": "SenhaForte@2026"
          },
          "municipio": {
            "type": "string",
            "maxLength": 100,
            "example": "São José dos Campos"
          },
          "aceite_privacidade": {
            "type": "boolean",
            "enum": [true],
            "example": true
          }
        }
      },
      "UsuarioPublicoResponse": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "email",
          "papel_id",
          "esta_ativo",
          "criado_em",
          "atualizado_em"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "11111111-2222-3333-4444-555555555555"
          },
          "nome": {
            "type": "string",
            "example": "Ana da Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana.silva@exemplo.com"
          },
          "papel_id": {
            "type": "string",
            "format": "uuid"
          },
          "municipio": {
            "type": "string",
            "nullable": true,
            "example": "São José dos Campos"
          },
          "esta_ativo": {
            "type": "boolean",
            "example": true
          },
          "aceite_privacidade_em": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "criado_em": {
            "type": "string",
            "format": "date-time"
          },
          "atualizado_em": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SeriesResponse": {
        "type": "object",
        "required": ["estacaoId", "grandeza", "periodo", "dados"],
        "properties": {
          "estacaoId": {
            "type": "string",
            "example": "estacao-01"
          },
          "grandeza": {
            "type": "string",
            "example": "PM25"
          },
          "periodo": {
            "type": "string",
            "enum": ["24h", "7d", "30d"],
            "example": "24h"
          },
          "dados": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["timestamp", "valor"],
              "properties": {
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2026-06-06T10:00:00-03:00"
                },
                "valor": {
                  "type": "number",
                  "example": 25.4
                }
              }
            }
          }
        }
      },
      "UltimasLeiturasResponse": {
        "type": "object",
        "required": ["estacaoId", "leituras"],
        "properties": {
          "estacaoId": {
            "type": "string",
            "example": "estacao-01"
          },
          "leituras": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "grandeza",
                "valorCalibrado",
                "unidade",
                "tempoRelativo"
              ],
              "properties": {
                "grandeza": {
                  "type": "string",
                  "example": "PM25"
                },
                "valorCalibrado": {
                  "type": "number",
                  "example": 18.2
                },
                "unidade": {
                  "type": "string",
                  "example": "µg/m³"
                },
                "tempoRelativo": {
                  "type": "string",
                  "example": "há 5 min"
                }
              }
            }
          }
        }
      },
      "IqarResponse": {
        "type": "object",
        "required": [
          "estacaoId",
          "indice",
          "status",
          "rotuloFaixa",
          "mensagem",
          "municipio"
        ],
        "properties": {
          "estacaoId": {
            "type": "string",
            "example": "EST-HIST-01"
          },
          "indice": {
            "oneOf": [
              {
                "type": "number",
                "example": 15
              },
              {
                "type": "string",
                "example": "Sem dados suficientes"
              }
            ]
          },
          "classificacao": {
            "type": "string",
            "example": "Boa"
          },
          "status": {
            "type": "string",
            "example": "Boa"
          },
          "cor": {
            "type": "string",
            "example": "#00E400"
          },
          "rotuloFaixa": {
            "type": "string",
            "example": "Boa"
          },
          "mensagem": {
            "type": "string",
            "example": "Qualidade do ar considerada boa."
          },
          "municipio": {
            "type": "string",
            "example": "São José dos Campos"
          }
        }
      },
      "Medicao": {
        "type": "object",
        "required": [
          "lidoEm",
          "estacaoCodigo",
          "estacaoNome",
          "municipio",
          "sensorCodigo",
          "grandeza",
          "unidade",
          "valor",
          "valorBruto",
          "valida"
        ],
        "properties": {
          "lidoEm": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-06T14:05:00Z"
          },
          "estacaoCodigo": {
            "type": "string",
            "example": "EST-001"
          },
          "estacaoNome": {
            "type": "string",
            "example": "Centro"
          },
          "municipio": {
            "type": "string",
            "example": "São José dos Campos"
          },
          "sensorCodigo": {
            "type": "string",
            "nullable": true,
            "example": "T-01"
          },
          "grandeza": {
            "type": "string",
            "example": "Temperatura"
          },
          "unidade": {
            "type": "string",
            "example": "°C"
          },
          "valor": {
            "type": "number",
            "example": 23.4
          },
          "valorBruto": {
            "type": "number",
            "example": 24.9
          },
          "valida": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "ListaMedicoes": {
        "type": "object",
        "required": [
          "municipio",
          "inicio",
          "fim",
          "pagina",
          "porPagina",
          "total",
          "medicoes"
        ],
        "properties": {
          "municipio": {
            "type": "string",
            "example": "São José dos Campos"
          },
          "inicio": {
            "type": "string",
            "format": "date",
            "example": "2026-11-06"
          },
          "fim": {
            "type": "string",
            "format": "date",
            "example": "2026-11-06"
          },
          "pagina": {
            "type": "integer",
            "example": 1
          },
          "porPagina": {
            "type": "integer",
            "example": 500
          },
          "total": {
            "type": "integer",
            "example": 1440
          },
          "medicoes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Medicao"
            }
          }
        }
      },
      "MunicipiosPublicoResponse": {
        "type": "object",
        "required": ["municipios"],
        "properties": {
          "municipios": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "São José dos Campos"
            }
          }
        }
      },
      "StatusEstacoesMunicipioResponse": {
        "type": "object",
        "required": ["resumo", "estacoes"],
        "properties": {
          "resumo": {
            "type": "object",
            "required": ["total", "ativas", "com_falha", "inativas"],
            "properties": {
              "total": {
                "type": "integer",
                "example": 3
              },
              "ativas": {
                "type": "integer",
                "example": 2
              },
              "com_falha": {
                "type": "integer",
                "example": 0
              },
              "inativas": {
                "type": "integer",
                "example": 1
              }
            }
          },
          "estacoes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "nome", "status_operacional"],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "nome": {
                  "type": "string",
                  "example": "Estação Centro"
                },
                "status_operacional": {
                  "type": "string",
                  "example": "Ativa"
                }
              }
            }
          }
        }
      },
      "QuotaExceededResponse": {
        "type": "object",
        "required": ["erro", "renovaEm"],
        "properties": {
          "erro": {
            "type": "string",
            "example": "Limite de cota semanal de requisições excedido para o seu perfil."
          },
          "renovaEm": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-23T00:00:00.000Z"
          },
          "semanaRestante": {
            "type": "integer",
            "example": 0
          },
          "mesRestante": {
            "type": "integer",
            "example": 120
          }
        }
      },
      "ErroRelatorioResponse": {
        "type": "object",
        "required": ["erro"],
        "properties": {
          "erro": {
            "type": "string",
            "example": "Município não encontrado."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Mensagem descritiva do erro."
          }
        }
      }
    }
  }
}
