# Docker Hub
DOCKERHUB_USER=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# RabbitMQ
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_RECOVERY_INTERVAL_MS=10000

# MQTT Mosquitto (usuário criado com scripts/mqtt/nova-estacao.sh ingestao-dados)
MOSQUITTO_USER=
MOSQUITTO_PASSWORD=
# 1 = pelo menos uma vez | 2 = exatamente uma vez
MQTT_QOS=1

# Auth (auth-service)
JWT_SECRET=
JWT_EXPIRES_IN=

# Simulador de estações (usuário criado com scripts/mqtt/nova-estacao.sh simulador)
SIMULADOR_USER=simulador
SIMULADOR_PASSWORD=
# UUIDs das estações simuladas, separados por vírgula
SIM_ESTACAO_IDS=
SIM_INTERVALO_S=5

# Defeitos do simulador (0 = todas as mensagens válidas)
SIM_TAXA_ERRO=50
# Tipos ligados, separados por vírgula (vazio = todos):
# payload_malformado,sem_timestamp,estacao_inexistente,estacao_inativa,bateria_invalida,duplicata,sensor_inexistente,valor_impossivel
SIM_TIPOS_ERRO=duplicata,sem_timestamp
# Semente opcional para repetir a mesma sequência de defeitos
SIM_SEED=
# UUID de uma estação cadastrada e INATIVA (obrigatório se estacao_inativa estiver ligado)
SIM_ESTACAO_INATIVA_ID=
