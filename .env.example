# Docker Hub
DOCKERHUB_USER=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# RabbitMQ
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_RECOVERY_INTERVAL_MS=10000

# Valkey (substitui o Redis). Obrigatória: o compose não sobe sem ela.
# A senha entra na URL de conexão: use só letras, números, "-" e "_".
VALKEY_PASSWORD=

# MQTT Mosquitto: sem usuário, senha ou certificado (US-29). A estação se
# identifica pelo MAC no clientId e no tópico. Ver mosquitto/LEIAME.md.
# 1 = pelo menos uma vez | 2 = exatamente uma vez
MQTT_QOS=1

# E-mail dos avisos de alarme (alertas-notificacoes, US-23).
# Em desenvolvimento, vazio usa o Mailpit do compose (caixa em http://localhost:8025).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Auth (auth-service)
JWT_SECRET=
JWT_EXPIRES_IN=
INTERNAL_TOKEN=

# Simulador de estações (conecta no broker sem credencial)
# Obrigatório para o simulador subir: sem ele, o contêiner reinicia em loop.
# UUIDs das estações simuladas, separados por vírgula
# (ex.: 00000000-0000-4000-8000-000000000001,00000000-0000-4000-8000-000000000002)
SIM_ESTACAO_IDS=
SIM_INTERVALO_S=5
# Endereço do gestao-estacoes: o simulador lê os sensores de cada estação dele (rota interna, com o INTERNAL_TOKEN)
SIM_API_URL=http://gestao-estacoes:3000

# Defeitos do simulador (0 = todas as mensagens válidas)
SIM_TAXA_ERRO=50
# Tipos ligados, separados por vírgula (vazio = todos):
# payload_malformado,sem_timestamp,estacao_inexistente,estacao_inativa,bateria_invalida,duplicata,sensor_inexistente,valor_impossivel
SIM_TIPOS_ERRO=duplicata,sem_timestamp
# Semente opcional para repetir a mesma sequência de defeitos
SIM_SEED=
# UUID de uma estação cadastrada e INATIVA (obrigatório se estacao_inativa estiver ligado)
SIM_ESTACAO_INATIVA_ID=

# Monitoramento (Grafana, ELEM-129). Usado por monitoramento/docker-compose.monitoring.yml
GRAFANA_USER=admin
GRAFANA_PASSWORD=
