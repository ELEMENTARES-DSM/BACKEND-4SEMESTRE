# Docker Hub
DOCKERHUB_USER=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# RabbitMQ
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# MQTT Mosquitto (usuário criado com scripts/mqtt/nova-estacao.sh ingestao-dados)
MOSQUITTO_USER=
MOSQUITTO_PASSWORD=
# 1 = pelo menos uma vez | 2 = exatamente uma vez
MQTT_QOS=1

# Auth (auth-service)
JWT_SECRET=
JWT_EXPIRES_IN=

# Simulador de estações (usuário criado com scripts/mqtt/nova-estacao.sh simulador)
SIMULADOR_USER=simulador
SIMULADOR_PASSWORD=
# UUIDs das estações simuladas, separados por vírgula
SIM_ESTACAO_IDS=
SIM_INTERVALO_S=5