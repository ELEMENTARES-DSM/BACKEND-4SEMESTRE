# Valkey do Pulso Urbano, uma instância por papel (pulso-valkey@s1, pulso-valkey@s2).
# Gerado pelo instalador. Configuração em /etc/pulso-urbano/valkey-%i.conf.
[Unit]
Description=Valkey do Pulso Urbano (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=valkey
Group=valkey
ExecStart=/usr/bin/valkey-server /etc/pulso-urbano/valkey-%i.conf --supervised systemd --daemonize no
Restart=always
RestartSec=3
TimeoutStopSec=60
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pulso-urbano/valkey-%i

[Install]
WantedBy=multi-user.target
