{
  "openapi": "3.0.3",
  "info": {
    "title": "Elementares — Validação",
    "version": "1.0.0",
    "description": "Operações HTTP do serviço servico-validacao."
  },
  "servers": [
    {
      "url": "http://localhost/validacao",
      "description": "Desenvolvimento local"
    }
  ],
  "tags": [
    {
      "name": "Saúde",
      "description": "Estado do serviço, conexões com PostgreSQL e RabbitMQ e disponibilidade da fila validacao.telemetria"
    },
    {
      "name": "Métricas",
      "description": "Contadores da validação desde o último início do serviço"
    },
    {
      "name": "DLQ",
      "description": "Reenvio manual dos eventos da validacao.dlq depois de corrigida a causa"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Saúde"
        ],
        "operationId": "servico_validacao_health",
        "summary": "Verificar o serviço, as conexões com PostgreSQL e RabbitMQ e a fila de telemetria",
        "description": "Rota pública. Informa se o serviço está conectado ao banco PostgreSQL e ao RabbitMQ e se a fila validacao.telemetria está disponível para consumo. Responde 503 enquanto qualquer dependência estiver indisponível.",
        "security": [],
        "responses": {
          "200": {
            "description": "Serviço conectado ao PostgreSQL e ao RabbitMQ com a fila validacao.telemetria disponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "conexoes": {
                    "postgres": "conectado",
                    "rabbitmq": "conectado"
                  },
                  "fila": "disponivel"
                }
              }
            }
          },
          "503": {
            "description": "Serviço no ar, mas sem conexão com o banco, RabbitMQ ou com a fila validacao.telemetria indisponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "examples": {
                  "filaIndisponivel": {
                    "summary": "Fila validacao.telemetria ausente",
                    "value": {
                      "status": "indisponivel",
                      "conexoes": {
                        "postgres": "conectado",
                        "rabbitmq": "conectado"
                      },
                      "fila": "indisponivel"
                    }
                  },
                  "rabbitmqDesconectado": {
                    "summary": "RabbitMQ desconectado",
                    "value": {
                      "status": "indisponivel",
                      "conexoes": {
                        "postgres": "conectado",
                        "rabbitmq": "desconectado"
                      },
                      "fila": "indisponivel"
                    }
                  },
                  "postgresDesconectado": {
                    "summary": "PostgreSQL desconectado",
                    "value": {
                      "status": "indisponivel",
                      "conexoes": {
                        "postgres": "desconectado",
                        "rabbitmq": "conectado"
                      },
                      "fila": "disponivel"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/metricas": {
      "get": {
        "tags": [
          "Métricas"
        ],
        "operationId": "servico_validacao_metricas",
        "summary": "Obter métricas da validação",
        "description": "Retorna os contadores da validação desde o último início do serviço. `leiturasIgnoradasSensorInativo` soma as leituras de sensores com situação Inativo, que não viram medida e não vão para a DLQ (US-18). `medidasInvalidasGravadas` soma as medidas gravadas com `valida` falso porque o valor real ficou fora da faixa física da grandeza (US-19). Os contadores ficam em memória, começam em 0 e zeram ao reiniciar o serviço. Restrito ao perfil ADMINISTRADOR.\n\nExemplo de requisição:\n\n```\ncurl http://localhost/validacao/metricas \\\n  -H \"Authorization: Bearer <token>\"\n```",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Métricas retornadas com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricasResponse"
                },
                "examples": {
                  "comIgnoradas": {
                    "summary": "Leituras de sensor inativo ignoradas e medidas inválidas gravadas",
                    "value": {
                      "leiturasIgnoradasSensorInativo": 3,
                      "medidasInvalidasGravadas": 2
                    }
                  },
                  "servicoRecemIniciado": {
                    "summary": "Serviço recém-iniciado",
                    "value": {
                      "leiturasIgnoradasSensorInativo": 0,
                      "medidasInvalidasGravadas": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "tokenNaoInformado": {
                    "summary": "Token não informado",
                    "value": {
                      "erro": "Autenticação necessária. Token não informado ou formato inválido."
                    }
                  },
                  "tokenInvalido": {
                    "summary": "Token inválido",
                    "value": {
                      "erro": "Token inválido ou expirado."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acesso negado para o perfil do usuário.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "perfilInsuficiente": {
                    "summary": "Perfil insuficiente",
                    "value": {
                      "erro": "Acesso negado. Perfil insuficiente para esta ação."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/dlq/reenviar": {
      "post": {
        "tags": [
          "DLQ"
        ],
        "operationId": "servico_validacao_dlq_reenviar",
        "summary": "Reenviar eventos da validacao.dlq para a fila de validação",
        "description": "Retira os eventos mais antigos da validacao.dlq, no máximo o número que estava na DLQ no início da chamada, e publica cada um de volta em validacao.telemetria com confirmação do RabbitMQ; só então o evento sai da DLQ. Evento do limite de entregas volta como está; leitura recusada pela US-18 volta sem `motivo` e `recusado_em`; evento malformado volta com o conteúdo original. Reenviar nunca duplica medida. Sem `quantidade`, reenvia todos. Só um reenvio por vez. Cada reenvio fica em log com o usuário, o horário e a quantidade. Restrito ao perfil ADMINISTRADOR.\n\nExemplo de requisição:\n\n```\ncurl -X POST http://localhost/validacao/dlq/reenviar \\\n  -H \"Authorization: Bearer <token>\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"quantidade\": 10}'\n```",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReenvioDlqRequest"
              },
              "examples": {
                "todos": {
                  "summary": "Reenviar todos os eventos da DLQ",
                  "value": {}
                },
                "quantidade": {
                  "summary": "Reenviar os 10 mais antigos",
                  "value": {
                    "quantidade": 10
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reenvio concluído.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReenvioDlqResponse"
                },
                "examples": {
                  "todos": {
                    "summary": "30 eventos na DLQ, sem quantidade",
                    "value": {
                      "reenviados": 30,
                      "restantes": 0
                    }
                  },
                  "quantidade": {
                    "summary": "30 eventos na DLQ, quantidade 10",
                    "value": {
                      "reenviados": 10,
                      "restantes": 20
                    }
                  },
                  "dlqVazia": {
                    "summary": "DLQ vazia",
                    "value": {
                      "reenviados": 0,
                      "restantes": 0
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`quantidade` informada não é um inteiro maior que zero. Nada é reenviado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                },
                "examples": {
                  "quantidadeInvalida": {
                    "summary": "Quantidade 0, negativa ou texto",
                    "value": {
                      "erro": "Quantidade inválida"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "tokenNaoInformado": {
                    "summary": "Token não informado",
                    "value": {
                      "erro": "Autenticação necessária. Token não informado ou formato inválido."
                    }
                  },
                  "tokenInvalido": {
                    "summary": "Token inválido",
                    "value": {
                      "erro": "Token inválido ou expirado."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acesso negado para o perfil do usuário.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "perfilInsuficiente": {
                    "summary": "Perfil insuficiente",
                    "value": {
                      "erro": "Acesso negado. Perfil insuficiente para esta ação."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Já existe um reenvio em andamento.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                },
                "examples": {
                  "reenvioEmAndamento": {
                    "summary": "Outro reenvio em andamento",
                    "value": {
                      "erro": "Reenvio já em andamento"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "RabbitMQ indisponível antes ou durante o reenvio. Os eventos não reenviados continuam na DLQ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                },
                "examples": {
                  "rabbitmqIndisponivel": {
                    "summary": "RabbitMQ fora do ar",
                    "value": {
                      "erro": "RabbitMQ indisponível"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "conexoes",
          "fila"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "indisponivel"
            ],
            "description": "\"ok\" quando PostgreSQL, RabbitMQ e a fila validacao.telemetria estão disponíveis; \"indisponivel\" caso contrário.",
            "example": "ok"
          },
          "conexoes": {
            "type": "object",
            "required": [
              "postgres",
              "rabbitmq"
            ],
            "description": "Estado de cada conexão externa do serviço.",
            "properties": {
              "postgres": {
                "type": "string",
                "enum": [
                  "conectado",
                  "desconectado"
                ],
                "description": "Conexão com o banco de dados PostgreSQL.",
                "example": "conectado"
              },
              "rabbitmq": {
                "type": "string",
                "enum": [
                  "conectado",
                  "desconectado"
                ],
                "description": "Conexão com o broker RabbitMQ.",
                "example": "conectado"
              }
            }
          },
          "fila": {
            "type": "string",
            "enum": [
              "disponivel",
              "indisponivel"
            ],
            "description": "Situação da fila validacao.telemetria.",
            "example": "disponivel"
          }
        }
      },
      "MetricasResponse": {
        "type": "object",
        "required": [
          "leiturasIgnoradasSensorInativo",
          "medidasInvalidasGravadas"
        ],
        "properties": {
          "leiturasIgnoradasSensorInativo": {
            "type": "integer",
            "minimum": 0,
            "description": "Leituras ignoradas porque o sensor está Inativo desde o último início do serviço. Uma reentrega do mesmo evento pode contar a mesma leitura de novo. Zera ao reiniciar."
          },
          "medidasInvalidasGravadas": {
            "type": "integer",
            "minimum": 0,
            "description": "Medidas gravadas com valida falso (valor real fora da faixa física da grandeza) desde o último início do serviço. A reentrega do mesmo evento não grava de novo e não conta. Zera ao reiniciar."
          }
        }
      },
      "ErroAutenticacaoResponse": {
        "type": "object",
        "required": [
          "erro"
        ],
        "properties": {
          "erro": {
            "type": "string",
            "description": "Descrição do erro de autenticação/autorização."
          }
        }
      },
      "ReenvioDlqRequest": {
        "type": "object",
        "properties": {
          "quantidade": {
            "type": "integer",
            "minimum": 1,
            "description": "Quantos eventos reenviar, dos mais antigos para os mais novos. Sem ele, reenvia todos.",
            "example": 10
          }
        }
      },
      "ReenvioDlqResponse": {
        "type": "object",
        "required": [
          "reenviados",
          "restantes"
        ],
        "properties": {
          "reenviados": {
            "type": "integer",
            "minimum": 0,
            "description": "Eventos publicados de volta em validacao.telemetria e retirados da DLQ."
          },
          "restantes": {
            "type": "integer",
            "minimum": 0,
            "description": "Eventos na DLQ ao fim da chamada, incluindo os que voltaram durante o reenvio."
          }
        }
      },
      "ErroResponse": {
        "type": "object",
        "required": [
          "erro"
        ],
        "properties": {
          "erro": {
            "type": "string",
            "description": "Descrição do erro."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT emitido pelo auth-service."
      }
    }
  }
}
