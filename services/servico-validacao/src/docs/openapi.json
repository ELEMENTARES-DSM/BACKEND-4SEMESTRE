{
  "openapi": "3.0.3",
  "info": {
    "title": "Elementares — Validação",
    "version": "1.0.0",
    "description": "Operações HTTP do serviço servico-validacao."
  },
  "servers": [
    {
      "url": "http://localhost/validacao",
      "description": "Desenvolvimento local"
    }
  ],
  "tags": [
    {
      "name": "Saúde",
      "description": "Verificação básica do processo HTTP"
    },
    {
      "name": "Métricas",
      "description": "Métricas operacionais da validação de leituras"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Saúde"
        ],
        "operationId": "servico_validacao_health",
        "summary": "Verificar se o serviço responde",
        "description": "Verifica se o processo HTTP responde. Não verifica a disponibilidade de bancos de dados, filas ou outros serviços.",
        "security": [],
        "responses": {
          "200": {
            "description": "Serviço disponível para receber requisições HTTP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "examples": {
                  "processoDisponivel": {
                    "summary": "Serviço disponível",
                    "value": {
                      "status": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/metricas": {
      "get": {
        "tags": [
          "Métricas"
        ],
        "operationId": "servico_validacao_metricas",
        "summary": "Obter métricas de leituras ignoradas por sensor inativo",
        "description": "Retorna o total de leituras ignoradas por sensor inativo. O contador fica em memória e zera ao reiniciar o serviço. Restrito ao perfil ADMINISTRADOR.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Métricas retornadas com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricasResponse"
                },
                "examples": {
                  "comLeiturasIgnoradas": {
                    "summary": "Leituras de sensor inativo ignoradas",
                    "value": {
                      "leiturasIgnoradasSensorInativo": 3
                    }
                  },
                  "semLeiturasIgnoradas": {
                    "summary": "Nenhuma leitura ignorada",
                    "value": {
                      "leiturasIgnoradasSensorInativo": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "tokenNaoInformado": {
                    "summary": "Token não informado",
                    "value": {
                      "erro": "Autenticação necessária. Token não informado ou formato inválido."
                    }
                  },
                  "tokenInvalido": {
                    "summary": "Token inválido",
                    "value": {
                      "erro": "Token inválido ou expirado."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acesso negado para o perfil do usuário.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "perfilInsuficiente": {
                    "summary": "Perfil insuficiente",
                    "value": {
                      "erro": "Acesso negado. Perfil insuficiente para esta ação."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "description": "Estado do processo HTTP.",
            "example": "ok"
          }
        }
      },
      "MetricasResponse": {
        "type": "object",
        "required": [
          "leiturasIgnoradasSensorInativo"
        ],
        "properties": {
          "leiturasIgnoradasSensorInativo": {
            "type": "integer",
            "minimum": 0,
            "description": "Leituras ignoradas por sensor inativo desde o último início do serviço; zera ao reiniciar."
          }
        }
      },
      "ErroAutenticacaoResponse": {
        "type": "object",
        "required": [
          "erro"
        ],
        "properties": {
          "erro": {
            "type": "string",
            "description": "Descrição do erro de autenticação/autorização."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT emitido pelo auth-service."
      }
    }
  }
}
