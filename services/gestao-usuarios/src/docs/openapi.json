{
  "openapi": "3.0.3",
  "info": {
    "title": "Elementares — Gestão de usuários",
    "version": "1.0.0",
    "description": "Operações HTTP do serviço gestao-usuarios."
  },
  "servers": [
    {
      "url": "http://localhost/usuarios",
      "description": "Desenvolvimento local"
    }
  ],
  "tags": [
    {
      "name": "Saúde",
      "description": "Verificação básica do processo HTTP"
    },
    {
      "name": "Munícipes",
      "description": "Autocadastro e operações voltadas aos cidadãos"
    }
  ],
  "paths": {
    "/cadastro": {
      "post": {
        "tags": [
          "Munícipes"
        ],
        "operationId": "gestao_usuarios_cadastrar_municipe",
        "summary": "Cadastrar novo munícipe",
        "description": "Permite que qualquer pessoa crie a própria conta pública (papel MUNICIPE). O cadastro exige nome, e-mail único, senha complexa (mínimo 8 caracteres com maiúscula, minúscula, dígito e símbolo) e aceite expresso do aviso de privacidade. Limitado a no máximo 5 cadastros por hora por IP.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CadastroMunicipeRequest"
              },
              "examples": {
                "cadastroValido": {
                  "summary": "Cadastro válido de munícipe",
                  "value": {
                    "nome": "Ana da Silva",
                    "email": "ana.silva@exemplo.com",
                    "senha": "SenhaForte@2026",
                    "municipio": "São José dos Campos",
                    "aceite_privacidade": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Munícipe cadastrado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioPublicoResponse"
                },
                "examples": {
                  "criadoComSucesso": {
                    "summary": "Munícipe criado",
                    "value": {
                      "id": "11111111-2222-3333-4444-555555555555",
                      "nome": "Ana da Silva",
                      "email": "ana.silva@exemplo.com",
                      "papel_id": "99999999-8888-7777-6666-555555555555",
                      "municipio": "São José dos Campos",
                      "esta_ativo": true,
                      "aceite_privacidade_em": "2026-11-17T12:00:00.000Z",
                      "criado_em": "2026-11-17T12:00:00.000Z",
                      "atualizado_em": "2026-11-17T12:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados de requisição inválidos (ex: senha fora do padrão, e-mail inválido ou falta de aceite do aviso de privacidade).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "semAceite": {
                    "summary": "Sem aceite do aviso de privacidade",
                    "value": {
                      "message": "Dados inválidos",
                      "errors": {
                        "aceite_privacidade": [
                          "O aceite do aviso de privacidade é obrigatório"
                        ]
                      }
                    }
                  },
                  "senhaFraca": {
                    "summary": "Senha não atende aos requisitos",
                    "value": {
                      "message": "Dados inválidos",
                      "errors": {
                        "senha": [
                          "Senha deve conter pelo menos um caractere especial"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflito: já existe um usuário com o e-mail informado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "emailDuplicado": {
                    "summary": "E-mail já cadastrado",
                    "value": {
                      "message": "E-mail já cadastrado"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite de taxa excedido: mais de 5 cadastros realizados por este IP na última hora.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "taxaExcedida": {
                    "summary": "Muitas tentativas",
                    "value": {
                      "message": "Limite de tentativas de cadastro excedido para este IP. Tente novamente mais tarde."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Saúde"
        ],
        "operationId": "gestao_usuarios_health",
        "summary": "Verificar se o serviço responde",
        "description": "Verifica se o processo HTTP responde. Não verifica a disponibilidade de bancos de dados, filas ou outros serviços.",
        "security": [],
        "responses": {
          "200": {
            "description": "Serviço disponível para receber requisições HTTP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "examples": {
                  "processoDisponivel": {
                    "summary": "Serviço disponível",
                    "value": {
                      "status": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CadastroMunicipeRequest": {
        "type": "object",
        "required": [
          "nome",
          "email",
          "senha",
          "aceite_privacidade"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "Nome completo do cidadão.",
            "example": "Ana da Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 150,
            "description": "Endereço de e-mail único do munícipe.",
            "example": "ana.silva@exemplo.com"
          },
          "senha": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 72,
            "description": "Senha com no mínimo 8 caracteres, contendo maiúscula, minúscula, número e caractere especial.",
            "example": "SenhaForte@2026"
          },
          "municipio": {
            "type": "string",
            "maxLength": 100,
            "description": "Município de interesse ou residência (opcional).",
            "example": "São José dos Campos"
          },
          "aceite_privacidade": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "Aceite obrigatório dos termos e aviso de privacidade da plataforma.",
            "example": true
          }
        }
      },
      "UsuarioPublicoResponse": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "email",
          "papel_id",
          "esta_ativo",
          "criado_em",
          "atualizado_em"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "11111111-2222-3333-4444-555555555555"
          },
          "nome": {
            "type": "string",
            "example": "Ana da Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana.silva@exemplo.com"
          },
          "papel_id": {
            "type": "string",
            "format": "uuid",
            "example": "99999999-8888-7777-6666-555555555555"
          },
          "municipio": {
            "type": "string",
            "nullable": true,
            "example": "São José dos Campos"
          },
          "esta_ativo": {
            "type": "boolean",
            "example": true
          },
          "aceite_privacidade_em": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2026-11-17T12:00:00.000Z"
          },
          "criado_em": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-17T12:00:00.000Z"
          },
          "atualizado_em": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-17T12:00:00.000Z"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "Dados inválidos"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "description": "Estado do processo HTTP.",
            "example": "ok"
          }
        }
      }
    }
  }
}
