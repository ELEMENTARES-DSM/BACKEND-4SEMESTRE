{
  "openapi": "3.0.3",
  "info": {
    "title": "Elementares — Alertas e notificações",
    "version": "1.0.0",
    "description": "Operações HTTP do serviço alertas-notificacoes."
  },
  "servers": [
    {
      "url": "http://localhost/alertas",
      "description": "Desenvolvimento local"
    }
  ],
  "tags": [
    {
      "name": "Saúde",
      "description": "Verificação básica do processo HTTP"
    },
    {
      "name": "Regras de alerta",
      "description": "Cadastro, consulta e ativação/inativação de regras de alerta por sensor"
    },
    {
      "name": "Alarmes",
      "description": "Consulta dos alarmes gravados pelas regras de alerta (US-24)"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Saúde"
        ],
        "operationId": "alertas_notificacoes_health",
        "summary": "Verificar se o serviço responde",
        "description": "Verifica se o processo HTTP responde. Não verifica a disponibilidade de bancos de dados, filas ou outros serviços.",
        "security": [],
        "responses": {
          "200": {
            "description": "Serviço disponível para receber requisições HTTP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "examples": {
                  "processoDisponivel": {
                    "summary": "Serviço disponível",
                    "value": {
                      "status": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/regras-alerta": {
      "post": {
        "tags": [
          "Regras de alerta"
        ],
        "operationId": "alertas_regras_create",
        "summary": "Criar regra de alerta",
        "description": "Cria uma regra de alerta para um sensor ativo. A regra sempre nasce ativa; campos extras são descartados. GESTOR_PUBLICO só atua em sensores do seu município (sensor de outro município responde 404, como se não existisse); ADMINISTRADOR tem acesso global. O valor limite deve ser coerente com o tipo do sensor (RN-04): Umidade Relativa 0 a 100; PM2.5, PM10 e Velocidade do Vento >= 0; Temperatura -90 a 60.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRegraAlertaRequest"
              },
              "examples": {
                "ca001": {
                  "summary": "CA-001: PM2.5 >= 50 µg/m³ crítico",
                  "value": {
                    "sensor_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "nome": "PM2.5 crítico",
                    "operador": ">=",
                    "valor_limite": 50.0,
                    "severidade": "CRITICO"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Regra criada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegraAlerta"
                },
                "examples": {
                  "ca001": {
                    "summary": "Regra criada (CA-001)",
                    "value": {
                      "id": "7b1e2c3d-4f5a-4b6c-8d7e-9f0a1b2c3d4e",
                      "sensor_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "nome": "PM2.5 crítico",
                      "operador": ">=",
                      "valor_limite": 50.0,
                      "severidade": "CRITICO",
                      "esta_ativo": true,
                      "criado_em": "2026-09-24T13:45:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Payload inválido ou JSON malformado.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ValidacaoErroResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ErroResponse"
                    }
                  ]
                },
                "examples": {
                  "dadosInvalidos": {
                    "summary": "Payload inválido",
                    "value": {
                      "message": "Dados inválidos",
                      "errors": {
                        "valor_limite": [
                          "Invalid input: expected number, received string"
                        ]
                      }
                    }
                  },
                  "jsonMalformado": {
                    "summary": "JSON malformado",
                    "value": {
                      "message": "JSON malformado."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "tokenAusente": {
                    "summary": "Token não informado",
                    "value": {
                      "erro": "Autenticação necessária. Token não informado ou formato inválido."
                    }
                  },
                  "tokenInvalido": {
                    "summary": "Token inválido",
                    "value": {
                      "erro": "Token inválido ou expirado."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão ou gestor público sem município no token.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ErroResponse"
                    }
                  ]
                },
                "examples": {
                  "perfilInsuficiente": {
                    "summary": "Perfil sem permissão",
                    "value": {
                      "erro": "Acesso negado. Perfil insuficiente para esta ação."
                    }
                  },
                  "semMunicipio": {
                    "summary": "Gestor sem município no token",
                    "value": {
                      "message": "Acesso negado: usuário sem município vinculado."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Sensor não encontrado ou, para GESTOR_PUBLICO, sensor de outro município (resposta idêntica).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                },
                "examples": {
                  "sensorNaoEncontrado": {
                    "summary": "Sensor inexistente ou de outro município",
                    "value": {
                      "message": "Sensor não encontrado."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Sensor inativo ou valor limite incoerente com a unidade do sensor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                },
                "examples": {
                  "sensorInativo": {
                    "summary": "Sensor inativo (RN-01)",
                    "value": {
                      "message": "Não é possível criar regra de alerta para um sensor inativo."
                    }
                  },
                  "foraDaFaixa": {
                    "summary": "Valor fora da faixa (RN-04)",
                    "value": {
                      "message": "O valor limite para sensores de PM2.5 deve ser maior ou igual a 0 µg/m³."
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Regras de alerta"
        ],
        "operationId": "alertas_regras_list",
        "summary": "Listar regras de alerta",
        "description": "Lista as regras de alerta com dados do sensor e da estação, ordenadas por criação (mais recentes primeiro). GESTOR_PUBLICO vê apenas as regras do seu município; ADMINISTRADOR vê todas.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de regras.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RegraAlertaDetalhada"
                  }
                },
                "examples": {
                  "lista": {
                    "summary": "Regras do município",
                    "value": [
                      {
                        "id": "7b1e2c3d-4f5a-4b6c-8d7e-9f0a1b2c3d4e",
                        "sensor_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                        "nome": "PM2.5 crítico",
                        "operador": ">=",
                        "valor_limite": 50.0,
                        "severidade": "CRITICO",
                        "esta_ativo": true,
                        "criado_em": "2026-09-24T13:45:00.000Z",
                        "sensor_tipo": "PM2.5",
                        "sensor_unidade_medida": "µg/m³",
                        "estacao_id": "9c8b7a6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d",
                        "estacao_codigo": "SJC-001",
                        "estacao_nome": "Estação Centro",
                        "municipio": "São José dos Campos"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "tokenAusente": {
                    "summary": "Token não informado",
                    "value": {
                      "erro": "Autenticação necessária. Token não informado ou formato inválido."
                    }
                  },
                  "tokenInvalido": {
                    "summary": "Token inválido",
                    "value": {
                      "erro": "Token inválido ou expirado."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão ou gestor público sem município no token.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ErroResponse"
                    }
                  ]
                },
                "examples": {
                  "perfilInsuficiente": {
                    "summary": "Perfil sem permissão",
                    "value": {
                      "erro": "Acesso negado. Perfil insuficiente para esta ação."
                    }
                  },
                  "semMunicipio": {
                    "summary": "Gestor sem município no token",
                    "value": {
                      "message": "Acesso negado: usuário sem município vinculado."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/regras-alerta/{id}/status": {
      "patch": {
        "tags": [
          "Regras de alerta"
        ],
        "operationId": "alertas_regras_update_status",
        "summary": "Ativar ou inativar regra de alerta",
        "description": "Altera o status da regra (inativação lógica; a regra nunca é removida). Não é possível ativar regra de um sensor inativo (RN-01); inativar é sempre permitido. Para GESTOR_PUBLICO, regra de outro município responde 404, como se não existisse.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador da regra de alerta.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRegraAlertaStatusRequest"
              },
              "examples": {
                "inativar": {
                  "summary": "Inativar regra",
                  "value": {
                    "status": "Inativa"
                  }
                },
                "ativar": {
                  "summary": "Ativar regra",
                  "value": {
                    "status": "Ativa"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Regra atualizada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegraAlerta"
                },
                "examples": {
                  "inativada": {
                    "summary": "Regra inativada",
                    "value": {
                      "id": "7b1e2c3d-4f5a-4b6c-8d7e-9f0a1b2c3d4e",
                      "sensor_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "nome": "PM2.5 crítico",
                      "operador": ">=",
                      "valor_limite": 50.0,
                      "severidade": "CRITICO",
                      "esta_ativo": false,
                      "criado_em": "2026-09-24T13:45:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Id inválido, status inválido ou JSON malformado.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ValidacaoErroResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ErroResponse"
                    }
                  ]
                },
                "examples": {
                  "statusInvalido": {
                    "summary": "Status fora do enum",
                    "value": {
                      "message": "Dados inválidos",
                      "errors": {
                        "status": [
                          "Invalid option: expected one of \"Ativa\"|\"Inativa\""
                        ]
                      }
                    }
                  },
                  "idInvalido": {
                    "summary": "Id não é UUID",
                    "value": {
                      "message": "Dados inválidos",
                      "errors": {
                        "id": [
                          "Invalid UUID"
                        ]
                      }
                    }
                  },
                  "jsonMalformado": {
                    "summary": "JSON malformado",
                    "value": {
                      "message": "JSON malformado."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "tokenAusente": {
                    "summary": "Token não informado",
                    "value": {
                      "erro": "Autenticação necessária. Token não informado ou formato inválido."
                    }
                  },
                  "tokenInvalido": {
                    "summary": "Token inválido",
                    "value": {
                      "erro": "Token inválido ou expirado."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão ou gestor público sem município no token.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ErroResponse"
                    }
                  ]
                },
                "examples": {
                  "perfilInsuficiente": {
                    "summary": "Perfil sem permissão",
                    "value": {
                      "erro": "Acesso negado. Perfil insuficiente para esta ação."
                    }
                  },
                  "semMunicipio": {
                    "summary": "Gestor sem município no token",
                    "value": {
                      "message": "Acesso negado: usuário sem município vinculado."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Regra não encontrada ou, para GESTOR_PUBLICO, regra de outro município (resposta idêntica).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                },
                "examples": {
                  "regraNaoEncontrada": {
                    "summary": "Regra inexistente ou de outro município",
                    "value": {
                      "message": "Regra de alerta não encontrada."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Tentativa de ativar regra de sensor inativo (RN-01).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                },
                "examples": {
                  "sensorInativo": {
                    "summary": "Sensor inativo (RN-01)",
                    "value": {
                      "message": "Não é possível ativar regra de um sensor inativo."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/alarmes": {
      "get": {
        "tags": [
          "Alarmes"
        ],
        "operationId": "alertas_alarmes_list",
        "summary": "Listar alarmes",
        "description": "Lista os alarmes, mais recentes primeiro (pelo horário da leitura), até 500. GESTOR_PUBLICO vê só os do seu município; ADMINISTRADOR vê todos. Os filtros combinam entre si. Exemplo: `curl \"http://localhost/alertas/alarmes?severidade=CRITICO&situacao=aberto\" -H \"Authorization: Bearer <token>\"`.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "de",
            "in": "query",
            "required": false,
            "description": "Leituras a partir deste horário (ISO 8601 com fuso).",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-10-24T00:00:00.000-03:00"
          },
          {
            "name": "ate",
            "in": "query",
            "required": false,
            "description": "Leituras até este horário (ISO 8601 com fuso).",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-10-24T23:59:59.999-03:00"
          },
          {
            "name": "severidade",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ATENCAO",
                "ALERTA",
                "CRITICO"
              ]
            }
          },
          {
            "name": "estacao_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "situacao",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "aberto",
                "normalizado"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de alarmes (vazia quando não há alarme no filtro).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Alarme"
                  }
                },
                "examples": {
                  "lista": {
                    "summary": "Alarme crítico aberto",
                    "value": [
                      {
                        "id": "0b6f2a4e-1c3d-4e5f-8a9b-1c2d3e4f5a6b",
                        "regra_id": "7b1e2c3d-4f5a-4b6c-8d7e-9f0a1b2c3d4e",
                        "regra_nome": "PM2.5 crítico",
                        "sensor_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                        "sensor_codigo": "PM25-01",
                        "sensor_tipo": "PM2.5",
                        "sensor_unidade_medida": "µg/m³",
                        "estacao_id": "9c8b7a6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d",
                        "estacao_codigo": "SJC-001",
                        "estacao_nome": "Estação Centro",
                        "municipio": "São José dos Campos",
                        "valor": 52.3,
                        "operador": ">=",
                        "limite": 50,
                        "severidade": "CRITICO",
                        "situacao": "aberto",
                        "lido_em": "2026-10-24T13:00:00.000Z",
                        "criado_em": "2026-10-24T13:00:01.412Z",
                        "normalizado_em": null
                      }
                    ]
                  },
                  "vazia": {
                    "summary": "Nenhum alarme no período",
                    "value": []
                  }
                }
              }
            }
          },
          "400": {
            "description": "Filtro inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidacaoErroResponse"
                },
                "examples": {
                  "datas": {
                    "summary": "Período invertido",
                    "value": {
                      "message": "Dados inválidos",
                      "errors": {
                        "ate": [
                          "de deve ser anterior ou igual a ate"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "tokenAusente": {
                    "summary": "Token não informado",
                    "value": {
                      "erro": "Autenticação necessária. Token não informado ou formato inválido."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão (o pesquisador não consulta alarmes) ou gestor sem município no token.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ErroResponse"
                    }
                  ]
                },
                "examples": {
                  "perfilInsuficiente": {
                    "summary": "Pesquisador",
                    "value": {
                      "erro": "Acesso negado. Perfil insuficiente para esta ação."
                    }
                  },
                  "semMunicipio": {
                    "summary": "Gestor sem município",
                    "value": {
                      "message": "Acesso negado: usuário sem município vinculado."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/alarmes/resumo": {
      "get": {
        "tags": [
          "Alarmes"
        ],
        "operationId": "alertas_alarmes_resumo",
        "summary": "Resumo dos alarmes abertos",
        "description": "Quantidade de alarmes abertos por severidade, para o indicador do cabeçalho. Bate com a lista filtrada por `situacao=aberto`. GESTOR_PUBLICO conta só o seu município.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Abertos por severidade.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumoAlarmes"
                },
                "examples": {
                  "resumo": {
                    "summary": "2 críticos e 1 alerta abertos",
                    "value": {
                      "abertos": {
                        "ATENCAO": 0,
                        "ALERTA": 1,
                        "CRITICO": 2
                      },
                      "total": 3
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "tokenAusente": {
                    "summary": "Token não informado",
                    "value": {
                      "erro": "Autenticação necessária. Token não informado ou formato inválido."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão (o pesquisador não consulta alarmes) ou gestor sem município no token.",
