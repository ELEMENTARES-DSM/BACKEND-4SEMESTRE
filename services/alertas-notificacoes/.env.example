PORT=3000
NODE_ENV=development
PUBLIC_API_URL=http://localhost/alertas
# Opcional: origem do Swagger UI em desenvolvimento (habilita CORS)
SWAGGER_UI_ORIGIN=

DATABASE_URL=postgresql://usuario:senha@localhost:5432/elementares
RABBITMQ_URL=amqp://usuario:senha@localhost:5672

# Deve ser o mesmo segredo usado pelo auth-service
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=1h

# E-mail dos avisos de alarme (US-23). Fora do compose, aponte para um SMTP de teste.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pulso Urbano <alertas@pulsourbano.local>
