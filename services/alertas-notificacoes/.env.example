PORT=3000
NODE_ENV=development
PUBLIC_API_URL=http://localhost/alertas
# Opcional: origem do Swagger UI em desenvolvimento (habilita CORS)
SWAGGER_UI_ORIGIN=

DATABASE_URL=postgresql://usuario:senha@localhost:5432/elementares
RABBITMQ_URL=amqp://usuario:senha@localhost:5672

# Deve ser o mesmo segredo usado pelo auth-service
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=1h
