{
  "openapi": "3.0.3",
  "info": {
    "title": "Elementares — Ingestão de dados",
    "version": "1.0.0",
    "description": "Operações HTTP do serviço ingestao-dados."
  },
  "servers": [
    {
      "url": "http://localhost/ingestao",
      "description": "Desenvolvimento local"
    }
  ],
  "tags": [
    {
      "name": "Saúde",
      "description": "Estado do serviço e das conexões com os brokers MQTT e RabbitMQ"
    },
    {
      "name": "Métricas",
      "description": "Métricas operacionais de ingestão de dados"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Saúde"
        ],
        "operationId": "ingestao_dados_health",
        "summary": "Verificar o serviço e as conexões com MQTT e RabbitMQ",
        "description": "Rota pública. Informa se o serviço está conectado aos brokers MQTT e RabbitMQ. Responde 503 enquanto qualquer uma das conexões estiver indisponível.",
        "security": [],
        "responses": {
          "200": {
            "description": "Serviço conectado aos brokers MQTT e RabbitMQ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "conexoes": {
                    "mqtt": "conectado",
                    "rabbitmq": "conectado"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Serviço no ar, mas sem conexão com pelo menos um dos brokers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "examples": {
                  "mqttDesconectado": {
                    "summary": "Broker MQTT desconectado",
                    "value": {
                      "status": "indisponivel",
                      "conexoes": {
                        "mqtt": "desconectado",
                        "rabbitmq": "conectado"
                      }
                    }
                  },
                  "rabbitmqDesconectado": {
                    "summary": "RabbitMQ desconectado",
                    "value": {
                      "status": "indisponivel",
                      "conexoes": {
                        "mqtt": "conectado",
                        "rabbitmq": "desconectado"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/metricas": {
      "get": {
        "tags": [
          "Métricas"
        ],
        "operationId": "ingestao_dados_metricas",
        "summary": "Obter métricas de ingestão (recebidas, recusadas, duplicadas, pendentes e encaminhadas)",
        "description": "Retorna, lidos do Valkey (contadores staging:contador:*), o total de mensagens recebidas pelo MQTT, as recusadas agrupadas por motivo, as duplicadas ignoradas, as pendentes de publicação no RabbitMQ, as encaminhadas para telemetria.bruta e o horário de chegada da pendente mais antiga. Os contadores não zeram ao reiniciar o serviço. Com todas as mensagens já verificadas, leiturasRecebidas = soma de leiturasRejeitadas + duplicadasIgnoradas + mensagensPendentes + mensagensEncaminhadas. Restrito ao perfil ADMINISTRADOR.\n\nExemplo de requisição:\n\n```\ncurl http://localhost/ingestao/metricas \\\n  -H \"Authorization: Bearer <token>\"\n```",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Métricas retornadas com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricasResponse"
                },
                "examples": {
                  "comRejeicoes": {
                    "summary": "Com recusas, duplicadas e pendentes esperando o RabbitMQ",
                    "value": {
                      "leiturasRecebidas": 120,
                      "leiturasRejeitadas": {
                        "Payload malformado": 3,
                        "Estação inativa": 1,
                        "Timestamp fora da faixa": 1
                      },
                      "duplicadasIgnoradas": 2,
                      "mensagensPendentes": 4,
                      "mensagensEncaminhadas": 109,
                      "pendenteMaisAntigaEm": "2026-11-16T10:00:05.123Z"
                    }
                  },
                  "semRejeicoes": {
                    "summary": "Tudo encaminhado, nenhuma recusa",
                    "value": {
                      "leiturasRecebidas": 48,
                      "leiturasRejeitadas": {},
                      "duplicadasIgnoradas": 0,
                      "mensagensPendentes": 0,
                      "mensagensEncaminhadas": 48,
                      "pendenteMaisAntigaEm": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "tokenNaoInformado": {
                    "summary": "Token não informado",
                    "value": {
                      "erro": "Autenticação necessária. Token não informado ou formato inválido."
                    }
                  },
                  "tokenInvalido": {
                    "summary": "Token inválido",
                    "value": {
                      "erro": "Token inválido ou expirado."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acesso negado para o perfil do usuário.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "perfilInsuficiente": {
                    "summary": "Perfil insuficiente",
                    "value": {
                      "erro": "Acesso negado. Perfil insuficiente para esta ação."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "conexoes"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "indisponivel"
            ],
            "description": "\"ok\" quando ambos os brokers estão conectados; \"indisponivel\" quando qualquer conexão caiu.",
            "example": "ok"
          },
          "conexoes": {
            "type": "object",
            "required": [
              "mqtt",
              "rabbitmq"
            ],
            "description": "Estado de cada conexão externa do serviço.",
            "properties": {
              "mqtt": {
                "type": "string",
                "enum": [
                  "conectado",
                  "desconectado"
                ],
                "description": "Conexão com o broker MQTT que entrega as leituras das estações.",
                "example": "conectado"
              },
              "rabbitmq": {
                "type": "string",
                "enum": [
                  "conectado",
                  "desconectado"
                ],
                "description": "Conexão com o RabbitMQ usado para publicar as telemetrias do staging.",
                "example": "conectado"
              }
            }
          }
        }
      },
      "MetricasResponse": {
        "type": "object",
        "required": [
          "leiturasRecebidas",
          "leiturasRejeitadas",
          "duplicadasIgnoradas",
          "mensagensPendentes",
          "mensagensEncaminhadas",
          "pendenteMaisAntigaEm"
        ],
        "properties": {
          "leiturasRecebidas": {
            "type": "integer",
            "minimum": 0,
            "description": "Mensagens gravadas no Valkey ao chegar do MQTT (staging:contador:recebidas), inclusive as de tópico fora do padrão e as que depois forem recusadas ou ignoradas como duplicata. Uma mensagem que o broker reenvia por falha na gravação conta uma vez só. Não zera ao reiniciar."
          },
          "leiturasRejeitadas": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Mensagens recusadas agrupadas por motivo (staging:contador:recusadas:{motivo}). Só aparecem os motivos que já tiveram alguma recusa; {} quando nenhuma."
          },
          "duplicadasIgnoradas": {
            "type": "integer",
            "minimum": 0,
            "description": "Mensagens com a mesma estação e horário de outra já vista nos últimos 7 dias (staging:contador:duplicadas). Não entram em leiturasRejeitadas nem seguem para telemetria.bruta."
          },
          "mensagensPendentes": {
            "type": "integer",
            "minimum": 0,
            "description": "Mensagens aceitas esperando publicação no RabbitMQ (tamanho da lista staging:pendentes no Valkey)."
          },
          "mensagensEncaminhadas": {
            "type": "integer",
            "minimum": 0,
            "description": "Mensagens publicadas em telemetria.bruta com confirmação do RabbitMQ (staging:contador:encaminhadas)."
          },
          "pendenteMaisAntigaEm": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Horário de chegada (recebidoEm) da mensagem na frente de staging:pendentes, a próxima a ser publicada. null quando não há pendentes."
          }
        }
      },
      "ErroAutenticacaoResponse": {
        "type": "object",
        "required": [
          "erro"
        ],
        "properties": {
          "erro": {
            "type": "string",
            "description": "Descrição do erro de autenticação/autorização."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT emitido pelo auth-service."
      }
    }
  }
}
