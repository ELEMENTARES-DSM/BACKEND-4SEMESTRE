{
  "openapi": "3.0.3",
  "info": {
    "title": "Elementares — Ingestão de dados",
    "version": "1.0.0",
    "description": "Operações HTTP do serviço ingestao-dados."
  },
  "servers": [
    {
      "url": "http://localhost/ingestao",
      "description": "Desenvolvimento local"
    }
  ],
  "tags": [
    {
      "name": "Saúde",
      "description": "Verificação básica do processo HTTP"
    },
    {
      "name": "Métricas",
      "description": "Métricas operacionais de ingestão de dados"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Saúde"
        ],
        "operationId": "ingestao_dados_health",
        "summary": "Verificar se o serviço responde",
        "description": "Verifica se o processo HTTP responde e informa a conexão com o RabbitMQ.",
        "security": [],
        "responses": {
          "200": {
            "description": "Serviço disponível para receber requisições HTTP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "examples": {
                  "processoDisponivel": {
                    "summary": "Serviço disponível",
                    "value": {
                      "status": "ok",
                      "rabbitmq": "conectado"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "RabbitMQ indisponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "rabbitmq": "desconectado"
                }
              }
            }
          }
        }
      }
    },
    "/metricas": {
      "get": {
        "tags": [
          "Métricas"
        ],
        "operationId": "ingestao_dados_metricas",
        "summary": "Obter métricas de ingestão",
        "description": "Retorna leituras rejeitadas, duplicatas ignoradas e mensagens pendentes no staging. Restrito ao perfil ADMINISTRADOR.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Métricas retornadas com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricasResponse"
                },
                "examples": {
                  "comRejeicoes": {
                    "summary": "Métricas com rejeições registradas",
                    "value": {
                      "leiturasRejeitadas": {
                        "VALOR_FORA_DA_FAIXA": 3,
                        "PAYLOAD_INVALIDO": 1
                      },
                      "duplicadasIgnoradas": 2,
                      "mensagensPendentes": 4
                    }
                  },
                  "semRejeicoes": {
                    "summary": "Nenhuma rejeição registrada",
                    "value": {
                      "leiturasRejeitadas": {},
                      "duplicadasIgnoradas": 0,
                      "mensagensPendentes": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "tokenNaoInformado": {
                    "summary": "Token não informado",
                    "value": {
                      "erro": "Autenticação necessária. Token não informado ou formato inválido."
                    }
                  },
                  "tokenInvalido": {
                    "summary": "Token inválido",
                    "value": {
                      "erro": "Token inválido ou expirado."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acesso negado para o perfil do usuário.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "perfilInsuficiente": {
                    "summary": "Perfil insuficiente",
                    "value": {
                      "erro": "Acesso negado. Perfil insuficiente para esta ação."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "rabbitmq"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "description": "Estado do processo HTTP.",
            "example": "ok"
          },
          "rabbitmq": {
            "type": "string",
            "enum": [
              "conectado",
              "desconectado"
            ]
          }
        }
      },
      "MetricasResponse": {
        "type": "object",
        "required": [
          "leiturasRejeitadas",
          "duplicadasIgnoradas",
          "mensagensPendentes"
        ],
        "properties": {
          "leiturasRejeitadas": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Contagem de leituras rejeitadas agrupadas por motivo."
          },
          "duplicadasIgnoradas": {
            "type": "integer",
            "minimum": 0,
            "description": "Mensagens duplicadas ignoradas desde o último início do serviço; não entram em leiturasRejeitadas e zeram ao reiniciar."
          },
          "mensagensPendentes": {
            "type": "integer",
            "minimum": 0,
            "description": "Quantidade de mensagens com status recebida ou pendente no staging."
          }
        }
      },
      "ErroAutenticacaoResponse": {
        "type": "object",
        "required": [
          "erro"
        ],
        "properties": {
          "erro": {
            "type": "string",
            "description": "Descrição do erro de autenticação/autorização."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT emitido pelo auth-service."
      }
    }
  }
}
