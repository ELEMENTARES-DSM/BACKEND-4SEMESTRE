{
  "openapi": "3.0.3",
  "info": {
    "title": "Elementares — Ingestão de dados",
    "version": "1.0.0",
    "description": "Operações HTTP do serviço ingestao-dados."
  },
  "servers": [
    {
      "url": "http://localhost/ingestao",
      "description": "Desenvolvimento local"
    }
  ],
  "tags": [
    {
      "name": "Saúde",
      "description": "Estado do serviço e das conexões com os brokers MQTT e RabbitMQ"
    },
    {
      "name": "Métricas",
      "description": "Métricas operacionais de ingestão de dados"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Saúde"
        ],
        "operationId": "ingestao_dados_health",
        "summary": "Verificar o serviço e as conexões com MQTT e RabbitMQ",
        "description": "Rota pública. Informa se o serviço está conectado aos brokers MQTT e RabbitMQ. Responde 503 enquanto qualquer uma das conexões estiver indisponível.",
        "security": [],
        "responses": {
          "200": {
            "description": "Serviço conectado aos brokers MQTT e RabbitMQ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "conexoes": {
                    "mqtt": "conectado",
                    "rabbitmq": "conectado"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Serviço no ar, mas sem conexão com pelo menos um dos brokers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "examples": {
                  "mqttDesconectado": {
                    "summary": "Broker MQTT desconectado",
                    "value": {
                      "status": "indisponivel",
                      "conexoes": {
                        "mqtt": "desconectado",
                        "rabbitmq": "conectado"
                      }
                    }
                  },
                  "rabbitmqDesconectado": {
                    "summary": "RabbitMQ desconectado",
                    "value": {
                      "status": "indisponivel",
                      "conexoes": {
                        "mqtt": "conectado",
                        "rabbitmq": "desconectado"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/metricas": {
      "get": {
        "tags": [
          "Métricas"
        ],
        "operationId": "ingestao_dados_metricas",
        "summary": "Obter métricas de ingestão (recebidas, rejeitadas e duplicadas)",
        "description": "Retorna o total de leituras recebidas pelo MQTT, o total de leituras rejeitadas agrupadas por motivo e, em campo separado, o total de mensagens duplicadas ignoradas. Os contadores ficam em memória e zeram ao reiniciar o serviço. Restrito ao perfil ADMINISTRADOR.\n\nExemplo de requisição:\n\n```\ncurl http://localhost/ingestao/metricas \\\n  -H \"Authorization: Bearer <token>\"\n```",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Métricas retornadas com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricasResponse"
                },
                "examples": {
                  "comRejeicoes": {
                    "summary": "Métricas com rejeições registradas",
                    "value": {
                      "leiturasRecebidas": 120,
                      "leiturasRejeitadas": {
                        "Payload malformado": 3,
                        "Estação inativa": 1
                      },
                      "duplicadasIgnoradas": 2,
                      "mensagensPendentes": 4
                    }
                  },
                  "semRejeicoes": {
                    "summary": "Nenhuma rejeição registrada",
                    "value": {
                      "leiturasRecebidas": 48,
                      "leiturasRejeitadas": {},
                      "duplicadasIgnoradas": 0,
                      "mensagensPendentes": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "tokenNaoInformado": {
                    "summary": "Token não informado",
                    "value": {
                      "erro": "Autenticação necessária. Token não informado ou formato inválido."
                    }
                  },
                  "tokenInvalido": {
                    "summary": "Token inválido",
                    "value": {
                      "erro": "Token inválido ou expirado."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acesso negado para o perfil do usuário.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroAutenticacaoResponse"
                },
                "examples": {
                  "perfilInsuficiente": {
                    "summary": "Perfil insuficiente",
                    "value": {
                      "erro": "Acesso negado. Perfil insuficiente para esta ação."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "conexoes"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "indisponivel"
            ],
            "description": "\"ok\" quando ambos os brokers estão conectados; \"indisponivel\" quando qualquer conexão caiu.",
            "example": "ok"
          },
          "conexoes": {
            "type": "object",
            "required": [
              "mqtt",
              "rabbitmq"
            ],
            "description": "Estado de cada conexão externa do serviço.",
            "properties": {
              "mqtt": {
                "type": "string",
                "enum": [
                  "conectado",
                  "desconectado"
                ],
                "description": "Conexão com o broker MQTT que entrega as leituras das estações.",
                "example": "conectado"
              },
              "rabbitmq": {
                "type": "string",
                "enum": [
                  "conectado",
                  "desconectado"
                ],
                "description": "Conexão com o RabbitMQ usado para publicar as telemetrias do staging.",
                "example": "conectado"
              }
            }
          }
        }
      },
      "MetricasResponse": {
        "type": "object",
        "required": [
          "leiturasRecebidas",
          "leiturasRejeitadas",
          "duplicadasIgnoradas",
          "mensagensPendentes"
        ],
        "properties": {
          "leiturasRecebidas": {
            "type": "integer",
            "minimum": 0,
            "description": "Mensagens de tópico válido entregues ao processamento desde o último início do serviço, inclusive as que depois forem rejeitadas ou ignoradas como duplicata. Tópico fora do padrão não conta. Zera ao reiniciar."
          },
          "leiturasRejeitadas": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Contagem de leituras rejeitadas agrupadas por motivo."
          },
          "duplicadasIgnoradas": {
            "type": "integer",
            "minimum": 0,
            "description": "Mensagens duplicadas ignoradas desde o último início do serviço; não entram em leiturasRejeitadas e zeram ao reiniciar."
          },
          "mensagensPendentes": {
            "type": "integer",
            "minimum": 0,
            "description": "Quantidade de mensagens com status recebida ou pendente no staging."
          }
        }
      },
      "ErroAutenticacaoResponse": {
        "type": "object",
        "required": [
          "erro"
        ],
        "properties": {
          "erro": {
            "type": "string",
            "description": "Descrição do erro de autenticação/autorização."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT emitido pelo auth-service."
      }
    }
  }
}
