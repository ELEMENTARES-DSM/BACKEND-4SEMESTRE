     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.7
       },
       {
        "color": "red",
        "value": 0.8
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   }
  },
  {
