   "targets": [
    {
     "refId": "A",
     "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.7
       },
       {
        "color": "red",
        "value": 0.85
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   }
  },
  {
